# ChrispyMPS — .env.example
# Copia questo file in .env.local e compila i valori reali.
# NON committare mai .env.local su GitHub.

# ===== SUPABASE =====
# Trovate su: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://PROGETTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ===== RESEND (email) =====
# https://resend.com → API Keys
RESEND_API_KEY=re_...

# ===== NEWSLETTER: quale provider usare =====
# mailerlite = stato attuale · both = MailerLite primario + copia in Brevo · brevo = cutover fatto
# Se vuota: mailerlite finche' MAILERLITE_API_KEY e' presente.
NEWSLETTER_PROVIDER=

# ===== MAILERLITE (newsletter — in uscita) =====
# https://dashboard.mailerlite.com → Integrations → API
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=   # ID del gruppo "Mappe" — trovalo in Groups

# ===== BREVO (newsletter — in entrata) =====
# https://app.brevo.com → SMTP & API → API Keys
BREVO_API_KEY=
# ID numerici delle liste — Contacts → Lists (si creano al primo setup)
BREVO_LIST_NEWSLETTER=    # "Newsletter BMX Settimanale"
BREVO_LIST_SIGNUP=        # "Account Chrispy Maps"
BREVO_LIST_SUBMIT_SPOT=   # "ChrispyMPS — Spot Submission"
# ID del template Double Opt-In. Se vuoto → single opt-in (comportamento MailerLite attuale).
BREVO_DOI_TEMPLATE_ID=

# ===== ADMIN =====
# Password per accedere a /admin — scegli una password robusta
ADMIN_PASSWORD=scegli-una-password-sicura
# Stringa random per firmare i cookie e i token email (min 32 caratteri)
ADMIN_SECRET=stringa-random-minimo-32-caratteri-qui

# ===== SITO =====
NEXT_PUBLIC_SITE_URL=https://maps.chrispybmx.com
